---
interface Props {
  eventId: string;
}
const { eventId } = Astro.props;
import legacyEntries from '../data/legacy/entries.json';
const entries = legacyEntries.filter((e) => e.eventId === eventId);
const links = (s: string): string[] => s.match(/https?:\/\/[^\s]+/g) ?? [];
---

<section class="legacy-entries">
  <h2>エントリー一覧</h2>
  <p class="muted">順不同・放送順ではありません（旧サイトのアーカイブより）</p>
  <ul class="legacy-entries__list">
    {entries.map((e) => {
      const videoLinks = links(e.fileURLs);
      return (
        <li class="legacy-entries__item">
          <h3>{e.name}</h3>
          {e.description && <p>{e.description}</p>}
          {videoLinks.length > 0 && (
            <div class="legacy-entries__links">
              {videoLinks.map((u) => (
                <a href={u} target="_blank" rel="noopener">
                  動画を見る
                </a>
              ))}
            </div>
          )}
        </li>
      );
    })}
  </ul>
</section>
