---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import xLogo from '../assets/site/x-logo-small-white.png';
import blueskyLogo from '../assets/site/bluesky_media_kit_logo_transparent_small_1.png';

const newsEntries = (await getCollection('news')).sort((a, b) =>
  (b.data.date ?? '').localeCompare(a.data.date ?? ''),
);

const newsItems = await Promise.all(
  newsEntries.map(async (entry) => ({
    title: entry.data.title,
    date: entry.data.date,
    displayDate: entry.data.date?.replaceAll('-', '.'),
    sns: entry.data.sns,
    Content: (await render(entry)).Content,
  })),
);

const [latestItem, ...olderItems] = newsItems;
---

{latestItem && (
  <section id="news" class="newsline" aria-labelledby="newsline-heading">
    <h2 id="newsline-heading" class="newsline__heading">NewsLine</h2>

    <details class="newsline__latest">
      <summary>
        <span class="newsline__label">NEWS</span>
        {latestItem.date && <time datetime={latestItem.date}>{latestItem.displayDate}</time>}
        <span class="newsline__latest-title">{latestItem.title}</span>
        <span class="newsline__toggle" aria-hidden="true">＋</span>
      </summary>

      <div class="newsline__latest-body">
        {latestItem.sns ? (
          <div class="newsline__sns-links">
            <a href="https://x.com/bluegrass_moon" target="_blank" rel="noopener" aria-label="Visit Bluegrass Moon on X">
              <Image alt="X logo" src={xLogo} format="webp" width={20} height={20} />
              <span>X</span>
            </a>
            <a href="https://bsky.app/profile/blmf-info.bsky.social" target="_blank" rel="noopener" aria-label="Visit BLMF Info on Bluesky">
              <Image alt="Bluesky logo" src={blueskyLogo} format="webp" width={20} height={20} />
              <span>Bluesky</span>
            </a>
          </div>
        ) : (
          <div class="newsline__body">
            <latestItem.Content />
          </div>
        )}
      </div>
    </details>

    {olderItems.length > 0 && (
      <div class="newsline__archive" data-news-carousel>
        <div class="newsline__archive-head">
          <div class="newsline__archive-label">
            <span>ARCHIVE</span>
            <span class="newsline__counter" data-news-counter>1 / {olderItems.length}</span>
          </div>
          <div class="newsline__controls" aria-label="ニュースを切り替える">
            <button type="button" data-news-prev aria-label="前のニュース">
              <span aria-hidden="true">←</span>
            </button>
            <button type="button" data-news-next aria-label="次のニュース">
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>

        <div class="newsline__track" data-news-track tabindex="0" aria-label="過去のニュース一覧">
          {olderItems.map((item) => (
            <details class="newsline__slide" data-news-slide>
              <summary>
                <div class="newsline__slide-topline">
                  {item.date && <time datetime={item.date}>{item.displayDate}</time>}
                  <span aria-hidden="true">＋</span>
                </div>
                <h3>{item.title}</h3>
              </summary>

              <div class="newsline__slide-body">
                {item.sns ? (
                  <div class="newsline__sns-links">
                    <a href="https://x.com/bluegrass_moon" target="_blank" rel="noopener" aria-label="Visit Bluegrass Moon on X">
                      <Image alt="X logo" src={xLogo} format="webp" width={20} height={20} />
                      <span>X</span>
                    </a>
                    <a href="https://bsky.app/profile/blmf-info.bsky.social" target="_blank" rel="noopener" aria-label="Visit BLMF Info on Bluesky">
                      <Image alt="Bluesky logo" src={blueskyLogo} format="webp" width={20} height={20} />
                      <span>Bluesky</span>
                    </a>
                  </div>
                ) : (
                  <div class="newsline__body">
                    <item.Content />
                  </div>
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    )}
  </section>
)}

<script>
  const initNewsCarousels = () => {
    document.querySelectorAll<HTMLElement>('[data-news-carousel]').forEach((carousel) => {
      if (carousel.dataset.bound === 'true') return;
      carousel.dataset.bound = 'true';

      const track = carousel.querySelector<HTMLElement>('[data-news-track]');
      const prev = carousel.querySelector<HTMLButtonElement>('[data-news-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-news-next]');
      const counter = carousel.querySelector<HTMLElement>('[data-news-counter]');
      const slides = track ? Array.from(track.querySelectorAll<HTMLElement>('[data-news-slide]')) : [];

      if (!track || !prev || !next || slides.length === 0) return;

      const currentIndex = () => {
        const trackLeft = track.getBoundingClientRect().left;
        let bestIndex = 0;
        let bestDistance = Number.POSITIVE_INFINITY;

        slides.forEach((slide, index) => {
          const distance = Math.abs(slide.getBoundingClientRect().left - trackLeft);
          if (distance < bestDistance) {
            bestDistance = distance;
            bestIndex = index;
          }
        });

        return bestIndex;
      };

      const updateControls = () => {
        const index = currentIndex();
        prev.disabled = index === 0;
        next.disabled = index === slides.length - 1;
        if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
      };

      const scrollToIndex = (index: number) => {
        const target = slides[Math.max(0, Math.min(index, slides.length - 1))];
        target?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
      };

      prev.addEventListener('click', () => scrollToIndex(currentIndex() - 1));
      next.addEventListener('click', () => scrollToIndex(currentIndex() + 1));

      let scrollTimer: number | undefined;
      track.addEventListener(
        'scroll',
        () => {
          window.clearTimeout(scrollTimer);
          scrollTimer = window.setTimeout(updateControls, 80);
        },
        { passive: true },
      );

      window.addEventListener('resize', updateControls);
      updateControls();
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNewsCarousels, { once: true });
  } else {
    initNewsCarousels();
  }

  document.addEventListener('astro:page-load', initNewsCarousels);
</script>

<style>
  .newsline {
    max-width: 900px;
    margin: 1rem auto 0;
    padding: 0.2rem 0;
    text-align: left;
    color: var(--white);
  }

  .newsline__heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .newsline__latest {
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(13, 30, 52, 0.14);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .newsline__latest summary {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    min-height: 3.4rem;
    padding: 0.7rem 0.2rem;
    cursor: pointer;
    list-style: none;
  }

  .newsline__latest summary::-webkit-details-marker,
  .newsline__slide summary::-webkit-details-marker {
    display: none;
  }

  .newsline__label {
    color: #ffd27a;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .newsline__latest time,
  .newsline__slide time {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .newsline__latest-title {
    min-width: 0;
    overflow: hidden;
    color: var(--white);
    font-size: 0.96rem;
    font-weight: 700;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .newsline__toggle {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    line-height: 1;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .newsline__latest summary:hover .newsline__toggle,
  .newsline__latest summary:focus-visible .newsline__toggle {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.08);
  }

  .newsline__latest[open] .newsline__toggle {
    transform: rotate(45deg);
  }

  .newsline__latest-body {
    padding: 0.2rem 0.2rem 1.1rem calc(0.72rem * 4 + 3.3rem);
  }

  .newsline__body {
    max-width: 690px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.88rem;
    line-height: 1.75;
  }

  .newsline__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .newsline__body :global(a) {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .newsline__archive {
    margin-top: 0.85rem;
  }

  .newsline__archive-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.55rem;
  }

  .newsline__archive-label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .newsline__counter {
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  .newsline__controls {
    display: flex;
    gap: 0.35rem;
  }

  .newsline__controls button {
    display: inline-grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    background: transparent;
    color: rgba(255, 255, 255, 0.86);
    font: inherit;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  .newsline__controls button:hover:not(:disabled),
  .newsline__controls button:focus-visible {
    border-color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-1px);
  }

  .newsline__controls button:disabled {
    opacity: 0.28;
    cursor: default;
  }

  .newsline__track {
    display: flex;
    gap: 0.7rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .newsline__track::-webkit-scrollbar {
    display: none;
  }

  .newsline__slide {
    flex: 0 0 calc(50% - 0.35rem);
    min-width: 0;
    overflow: hidden;
    scroll-snap-align: start;
    border: 1px solid rgba(255, 255, 255, 0.17);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .newsline__slide:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }

  .newsline__slide summary {
    display: block;
    padding: 0.9rem 0.95rem;
    cursor: pointer;
    list-style: none;
  }

  .newsline__slide-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .newsline__slide-topline > span {
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.9rem;
    transition: transform 0.2s ease;
  }

  .newsline__slide[open] .newsline__slide-topline > span {
    transform: rotate(45deg);
  }

  .newsline__slide h3 {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--white);
    font-size: 0.91rem;
    font-weight: 600;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .newsline__slide-body {
    padding: 0 0.95rem 1rem;
  }

  .newsline__sns-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .newsline__sns-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
  }

  .newsline__sns-links a:hover,
  .newsline__sns-links a:focus-visible {
    border-color: rgba(255, 255, 255, 0.38);
    background: rgba(255, 255, 255, 0.12);
  }

  .newsline__sns-links img {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 700px) {
    .newsline {
      margin-top: 0.85rem;
    }

    .newsline__latest summary {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.6rem;
      padding-block: 0.75rem;
    }

    .newsline__latest summary > time {
      display: none;
    }

    .newsline__latest-body {
      padding: 0.15rem 0.2rem 1rem;
    }

    .newsline__archive-head {
      margin-bottom: 0.45rem;
    }

    .newsline__slide {
      flex-basis: 88%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .newsline__toggle,
    .newsline__controls button,
    .newsline__slide,
    .newsline__slide-topline > span {
      transition: none;
    }
  }
</style>
