---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface GalleryImage {
  src: ImageMetadata;
  alt?: string;
}
interface Props {
  images: GalleryImage[];
  label?: string;
}
const { images, label = '開催時の様子' } = Astro.props;
---

<div class="gallery" role="region" aria-label={label}>
  <ul class="gallery__track">
    {images.map((img) => (
      <li class="gallery__item">
        <Image src={img.src} alt={img.alt ?? ''} format="webp" loading="lazy" />
      </li>
    ))}
  </ul>
</div>
