---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  volume?: string;
  eventDate?: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
}

const { title, volume, eventDate, heroImage, heroImageAlt } = Astro.props;
---

<BaseLayout title={`${title} | Bluegrass Lockdown Music Festival`}>
  <header class="event-hero">
    <div class="container">
      <p class="event-hero__eyebrow"><a href="/">&larr; トップページに戻る</a></p>
      <h1>{title}</h1>
      {volume && <p class="event-hero__meta">{volume}</p>}
      {eventDate && <p class="event-hero__meta">{eventDate}</p>}
      {heroImage && (
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ''}
          format="webp"
          class="event-hero__image"
        />
      )}
    </div>
  </header>

  <main class="event-body">
    <div class="container">
      <slot />
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
